#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Standalone tool window, same style as BPP_FreqFilter's main dialog
IDD_WAVEFORM DIALOGEX 0, 0, 256, 210
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "BPP_Waveform"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_SCOPE, "Static", SS_OWNERDRAW, 4, 4, 248, 170
    AUTORADIOBUTTON "All lines", IDC_ALL_LINES, 4, 180, 40, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Line", IDC_ONE_LINE, 46, 180, 28, 10
    EDITTEXT        IDC_LINE, 76, 178, 36, 12, ES_NUMBER | WS_GROUP
    CONTROL         "", IDC_LINE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
    AUTOCHECKBOX    "Low pass", IDC_LOWPASS, 124, 180, 44, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Highlight out of range:", IDC_PAINT, 4, 196, 86, 10, WS_GROUP | WS_TABSTOP
    COMBOBOX        IDC_PAINT_COLOR, 92, 194, 60, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Codes", IDC_SCALE_CODES, 170, 196, 34, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "mV", IDC_SCALE_MV, 206, 196, 26, 10
    PUSHBUTTON      "Close", IDCANCEL, 205, 178, 47, 13, WS_GROUP
END
