#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Standalone tool window: scope on the left, options on the right
IDD_VECTORSCOPE DIALOGEX 0, 0, 330, 234
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "BPP_Vectorscope"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_SCOPE, "Static", SS_OWNERDRAW, 4, 4, 232, 226

    GROUPBOX        "Display", -1, 242, 4, 84, 46
    AUTOCHECKBOX    "Colorize", IDC_COLORIZE, 248, 16, 60, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "Gain:", -1, 248, 33, 20, 8
    EDITTEXT        IDC_GAIN, 270, 31, 36, 12, ES_NUMBER | WS_GROUP
    CONTROL         "", IDC_GAIN_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0

    GROUPBOX        "Sampling", -1, 242, 54, 84, 44
    AUTORADIOBUTTON "All lines", IDC_ALL_LINES, 248, 66, 60, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Line", IDC_ONE_LINE, 248, 81, 26, 10
    EDITTEXT        IDC_LINE, 276, 80, 36, 12, ES_NUMBER | WS_GROUP
    CONTROL         "", IDC_LINE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0

    GROUPBOX        "Graticule", -1, 242, 102, 84, 62, WS_GROUP
    AUTORADIOBUTTON "None", IDC_GRAT_NONE, 248, 114, 60, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "75%", IDC_GRAT_75, 248, 126, 60, 10
    AUTORADIOBUTTON "100%", IDC_GRAT_100, 248, 138, 60, 10
    AUTORADIOBUTTON "Both", IDC_GRAT_BOTH, 248, 150, 60, 10

    PUSHBUTTON      "Close", IDCANCEL, 279, 217, 47, 13, WS_GROUP
END
