#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// Standalone tool window, same style as BPP_Waveform's
IDD_VECTORSCOPE DIALOGEX 0, 0, 256, 214
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "BPP_Vectorscope"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_SCOPE, "Static", SS_OWNERDRAW, 4, 4, 248, 186
    AUTORADIOBUTTON "All lines", IDC_ALL_LINES, 4, 198, 40, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Line", IDC_ONE_LINE, 46, 198, 28, 10
    EDITTEXT        IDC_LINE, 76, 196, 36, 12, ES_NUMBER | WS_GROUP
    CONTROL         "", IDC_LINE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
    PUSHBUTTON      "Close", IDCANCEL, 205, 196, 47, 13, WS_GROUP
END
